
alias clean_dropbox="find ~/Dropbox/ -name '* conflicted copy *' -exec rm {} \+"

function fix_dropbox_ignored() {
    gfind ~/Dropbox/ \
        -type d \( \
            -name "__pycache__"  \
            -o -name ".pytest*" \
            -o -name ".direnv" \
            -o -name ".venv" \
            -o -name ".git" \
            -o -name "*.egg-info" \
            -o -name "*.*_cache" \
        \) \
        -exec xattr -w com.dropbox.ignored {} \+ \
        -exec echo {} \;
}
